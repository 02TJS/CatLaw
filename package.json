{
  "name": "cat-law-workshop",
  "version": "0.14.38",
  "description": "法规驱动的等距像素猫咪工坊桌面游戏",
  "author": "CatLaw contributors",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "assets:emoji": "node --import tsx scripts/generate-emoji-assets.mts",
    "package:win": "npm run package:local",
    "package:local": "npm run build && electron-builder --win --x64 --dir --config.electronDist=electron-runtime-43.2.0",
    "package:portable": "npm run build && electron-builder --win portable --x64 --config.electronDist=electron-runtime-43.2.0 --config.compression=maximum --config.artifactName=CatWorkshop-${version}-portable.${ext}",
    "package:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never --config.compression=maximum --config.artifactName=CatWorkshop-${version}-mac-${arch}.${ext}",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never --config.compression=maximum --config.artifactName=CatWorkshop-${version}-mac-${arch}.${ext}",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:unit": "vitest run --maxWorkers=1",
    "qa:maintenance": "node scripts/qa-maintenance-entrypoints.mjs",
    "qa:browser:readme": "node scripts/qa-readme-schema14.mjs",
    "qa:electron:desktop": "node scripts/qa-electron-desktop-contract.mjs",
    "qa:package:unpacked": "node scripts/qa-fresh-pc-portable.mjs",
    "qa:package:single-exe": "node scripts/qa-fresh-pc-single-exe.mjs",
    "qa:live:deepseek": "node --import tsx scripts/qa-deepseek-api-audit.mts",
    "qa:progression:headless": "node --import tsx scripts/qa-deepseek-to-35-headless.mts --fixture",
    "qa:progression:browser": "node scripts/qa-deepseek-to-35-browser-gate.mjs",
    "qa:economy:extreme-tier-prices": "node --import tsx scripts/qa-extreme-tier-prices.mts",
    "report:progression": "node --import tsx scripts/generate-deepseek-to-35-report.mts",
    "test:deepseek:live": "npm run qa:live:deepseek",
    "test:progression:headless": "npm run qa:progression:headless",
    "test:progression:browser": "npm run qa:progression:browser",
    "test:extreme-tier-prices": "npm run qa:economy:extreme-tier-prices",
    "report:deepseek-to-35": "npm run report:progression"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.54.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.codex.catlaw.workshop",
    "productName": "猫咪工坊",
    "artifactName": "CatWorkshop.exe",
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
